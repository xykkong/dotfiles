# EditorConfig is awesome: https://editorconfig.org
root = true

# Default settings for all files
[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8
indent_style = space
indent_size = 2

# Markdown
[*.md]
trim_trailing_whitespace = false

# JSON
[*.json]
indent_style = space
indent_size = 2

# XML
[*.xml]
indent_style = space
indent_size = 4

# YAML
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Makefile
[Makefile]
indent_style = tab

# SQL
[*.sql]
indent_style = space
indent_size = 2

# Shell scripts
[*.{sh,bash}]
indent_style = space
indent_size = 2

# Terraform
[*.tf]
indent_style = space
indent_size = 2

[*.tfvars]
indent_style = space
indent_size = 2

# Java
[*.java]
indent_style = space
indent_size = 4
continuation_indent_size = 8

# Kotlin
[*.{kt,kts}]
indent_style = space
indent_size = 4
continuation_indent_size = 8

# JavaScript & React JSX
[*.{js,jsx}]
indent_style = space
indent_size = 2

# TypeScript & React TSX
[*.{ts,tsx}]
indent_style = space
indent_size = 2

# Python
[*.py]
indent_style = space
indent_size = 4

# Go
[*.go]
indent_style = tab

# Vim scripts
[*.vim]
indent_style = space
indent_size = 4

# Lua
[*.lua]
indent_style = space
indent_size = 2

# Ruby
[*.rb]
indent_style = space
indent_size = 2

# HTML
[*.{html,htm}]
indent_style = space
indent_size = 2

# CSS / SCSS / SASS
[*.{css,scss,sass}]
indent_style = space
indent_size = 2

# Vue
[*.vue]
indent_style = space
indent_size = 2

