[include]
  path = ~/.gitalias

[user]
  name = Xiao Yuan Kong
  email = 

[core]
  editor = nvim
  autocrlf = input
  pager = delta
  ; pager = diff-so-fancy | less --tabs=4 -RFX
  excludesfile = ~/.gitignore_global

[color]
  ui = auto

[delta]
  features = side-by-side line-numbers decorations
  syntax-theme = OneHalfDark
  navigate = true

[diff]
  # Git diff will use (i)ndex, (w)ork tree, (c)ommit and (o)bject
  # instead of a/b/c/d as prefixes for patches
  colorMoved = default
  mnemonicprefix = true
  algorithm = patience

[fetch]
  prune = true                     # Auto-remove deleted branches

[format]
  pretty = format:%C(blue)%ad%Creset %C(yellow)%h%C(green)%d%Creset %C(blue)%s %C(magenta) [%an]%Creset

[interactive]
  diffFilter = delta --color-only
  ; diffFilter = diff-so-fancy --patch

[merge]
  tool = nvimdiff
  conflictstyle = diff3

[pull]
  rebase = true                    # Avoid unnecessary merge commits

[rebase]
  autosquash = true                # Automatically reorder fixup/squash commits

[rerere]
  # Remember my merges
  enabled = true

[push]
  default = current                # Push only current branch
  autoSetupRemote = true           # Auto-add remote tracking on first push

